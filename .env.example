# Set on the server only. Never use VITE_ prefixes for credentials.
SONO_USERNAME=
SONO_PASSWORD=
PORT=3000
# Optional separately verified availability service. Not required for direct login.
SONO_CONNECTOR_URL=
SONO_CONNECTOR_TOKEN=

